   "source": [
    "### Write a Python program using OpenCV to perform color image enhancement through histogram equalization in the HSV color space on the given image **\"parrot.jpg\"**.\n",
    "\n",
    "The program should:\n",
    "\n",
    "- Import the required libraries (**OpenCV, NumPy, Matplotlib**).\n",
    "- Read the color image **\"parrot.jpg\"**.\n",
    "- Plot the **histogram of the original color image** (use the **B, G, and R** channels).\n",
    "- Convert the image from **BGR to HSV** color space.\n",
    "- Apply **histogram equalization** to one specific channel to improve brightness and contrast using `cv2.equalizeHist()`.\n",
    "- Convert the enhanced HSV image back to **BGR** format.\n",
    "- Using Matplotlib, display the following in a **2 × 2 grid layout**:\n",
    "  - Original Color Image\n",
    "  - Histogram of Original Image (BGR channels)\n",
    "  - Enhanced Color Image\n",
    "  - Histogram of Enhanced Image (BGR channels)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "cb8101f6-9032-4b40-a729-7dbf4adc9e0b",
   "metadata": {
    "id": "cb8101f6-9032-4b40-a729-7dbf4adc9e0b"
   },
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "998d76b7-3988-4288-b270-b577c83e23ff",
   "metadata": {
    "id": "998d76b7-3988-4288-b270-b577c83e23ff"
   },
   "outputs": [],
   "source": [
    "# Read the colorgiven parrot.jpg image.\n",
    "\n",
    "img = cv2.imread(\"parrot.jpg\")\n",
    "img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cbd3b9b6-2dbc-465e-933b-d117a8cd1de7",
   "metadata": {
    "id": "cbd3b9b6-2dbc-465e-933b-d117a8cd1de7"
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Plot the histogram of colour image\n",
    "colors = ('b', 'g', 'r')\n",
    "\n",
    "plt.figure(figsize=(6,4))\n",
    "for i, color in enumerate(colors):\n",
    "    hist = cv2.calcHist([img], [i], None, [256], [0,256])\n",
    "    plt.plot(hist, color=color)\n",
    "\n",
    "plt.title(\"Histogram of Original Color Image\")\n",
    "plt.xlabel(\"Pixel Intensity\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.show()\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "d12613a8-3fec-4b56-a7d7-8acf2b6ee9c1",
   "metadata": {
    "id": "d12613a8-3fec-4b56-a7d7-8acf2b6ee9c1"
   },
   "outputs": [],
   "source": [
    "# Convert to HSV.\n",
    "\n",
    "hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "645ed2d7-03c2-4d0b-bae1-8a5937873ec8",
   "metadata": {
    "id": "645ed2d7-03c2-4d0b-bae1-8a5937873ec8"
   },
   "outputs": [],
   "source": [
    "# Perform histogram equalization\n",
    "h, s, v = cv2.split(hsv)\n",
    "\n",
    "v_eq = cv2.equalizeHist(v)\n",
    "\n",
    "hsv_eq = cv2.merge((h, s, v_eq))\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "1ab0b5d1-5227-47fc-b7f2-78bcb28a16bd",
   "metadata": {
    "id": "1ab0b5d1-5227-47fc-b7f2-78bcb28a16bd"
   },
   "outputs": [],
   "source": [
    "# Convert back to BGR format\n",
    "\n",
    "enhanced = cv2.cvtColor(hsv_eq, cv2.COLOR_HSV2BGR)\n",
    "enhanced_rgb = cv2.cvtColor(enhanced, cv2.COLOR_BGR2RGB)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "6cd5d6c1-cc76-40d2-99fd-c860ef637c72",
   "metadata": {
    "id": "6cd5d6c1-cc76-40d2-99fd-c860ef637c72"
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x800 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Display\n",
    "plt.figure(figsize=(10,8))\n",
    "\n",
    "plt.subplot(2,2,1)\n",
    "plt.imshow(img_rgb)\n",
    "plt.title(\"Original Color Image\")\n",
    "plt.axis(\"off\")\n",
    "\n",
    "plt.subplot(2,2,2)\n",
    "for i, color in enumerate(colors):\n",
    "    hist = cv2.calcHist([img], [i], None, [256], [0,256])\n",
    "    plt.plot(hist, color=color)\n",
    "plt.title(\"Histogram of Original Image\")\n",
    "\n",
    "plt.subplot(2,2,3)\n",
    "plt.imshow(enhanced_rgb)\n",
    "plt.title(\"Enhanced Color Image\")\n",
    "plt.axis(\"off\")\n",
    "\n",
    "plt.subplot(2,2,4)\n",
    "for i, color in enumerate(colors):\n",
    "    hist = cv2.calcHist([enhanced], [i], None, [256], [0,256])\n",
    "    plt.plot(hist, color=color)\n",
    "plt.title(\"Histogram of Enhanced Image\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n"
   ]
